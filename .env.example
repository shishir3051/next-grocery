# FreshBasket environment variables
# Copy this file to .env.local (development) or set the same keys in your host's
# environment settings (Vercel → Project → Settings → Environment Variables).
# Never commit real values. .env* files other than this template are git-ignored.

# --- Required -------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or self-hosted).
# Special characters in the password are URL-encoded automatically.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/freshbasket?retryWrites=true&w=majority

# Public URL of the site, no trailing slash. Used by NextAuth and payment callbacks.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Long random secret that signs sessions and one-time codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out.
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Email for verification and password-reset codes (Gmail: use an App Password,
# not your account password). Required in production; in development the codes are
# printed to the server console when these are empty.
EMAIL_USER=
EMAIL_PASS=

# --- Payments: SSLCommerz (optional; cash on delivery works without it) ------------

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" uses the live gateway; anything else uses the sandbox.
IS_LIVE=false

# --- AI search and recipes (optional) ---------------------------------------------

# Google Gemini key from https://aistudio.google.com. Without it, search falls back to
# keyword matching and recipes to a curated list.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Maps and geocoding (optional) -------------------------------------------------

# Server-only Barikoi key for Bangladeshi address search. Without it, OpenStreetMap
# Nominatim is used. Do NOT use the old NEXT_PUBLIC_BARIKOI_API_KEY name: NEXT_PUBLIC_
# values are shipped to every visitor's browser.
BARIKOI_API_KEY=
# Map tiles. Defaults to OpenStreetMap; use a commercial provider for heavy traffic.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# --- Development only --------------------------------------------------------------

# Extra hosts allowed to load the dev server (e.g. your LAN IP to test on a phone).
# DEV_ALLOWED_ORIGINS=192.168.1.20
