{
  "name": "next-grocery",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "promote-admin": "node --env-file=.env.local scripts/promote-admin.mjs",
    "normalize-emails": "node --env-file=.env.local scripts/normalize-emails.mjs",
    "db:indexes": "node database/indexes.js",
    "db:seed": "node database/seed.js",
    "db:setup": "npm run db:indexes && npm run db:seed -- --demo-users"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tabler/icons-react": "^3.41.1",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^1.7.0",
    "mongoose": "^9.11.4",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
